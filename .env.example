# ── Auth.js (Google OAuth) — REQUIRED ────────────────────────────────────────
# Generate a secret:  openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# ── Neon Postgres — REQUIRED ─────────────────────────────────────────────────
# Copy the "pooled connection string" from your Neon dashboard.
DATABASE_URL=postgresql://user:password@host.neon.tech/stillhere?sslmode=require

# ── DeepSeek — REQUIRED for the AI reflection (F2) ──────────────────────────
DEEPSEEK_API_KEY=your-deepseek-api-key
# Optional: set to the V4 Flash model id once it is published.
DEEPSEEK_MODEL=deepseek-chat

# ── Public site URL ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://stillherememory.com
